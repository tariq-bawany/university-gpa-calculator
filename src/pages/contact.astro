---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact GPABound" description="Contact GPABound about grading scales, corrections, partnerships, or support.">
  <div class="wrap legal-page"><span class="eyebrow">CONTACT</span><h1>How can we help?</h1><p class="lead">Found an incorrect grading scale, want to suggest a university, or have a general question? Send us a note.</p>
    <div class="contact-grid"><section class="contact-card"><h2>Email us</h2><p>For corrections and general support:</p><a class="contact-link" href="mailto:hello@gpabound.com">hello@gpabound.com →</a><p class="muted">Include the university, campus, and a link to the official academic policy when reporting scale data.</p></section><section class="contact-card"><h2>Response time</h2><p>We aim to review scale corrections within 3–5 business days. General enquiries may take a little longer.</p><h3>Please don't send</h3><p class="muted">Student IDs, transcripts, passwords, or other sensitive academic information.</p></section></div>
  </div>
</BaseLayout>
