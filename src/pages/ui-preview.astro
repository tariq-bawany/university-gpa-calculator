---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/CalculatorWidget.jsx';
import CommonScaleReference from '../components/CommonScaleReference.astro';
const scale=[{grade:'A',gpa:4},{grade:'A-',gpa:3.7},{grade:'B+',gpa:3.3},{grade:'B',gpa:3},{grade:'B-',gpa:2.7},{grade:'C+',gpa:2.3},{grade:'C',gpa:2},{grade:'D',gpa:1},{grade:'F',gpa:0}];
---
<BaseLayout title="Calculator UI Concept | GPABound" description="Private design preview." noindex={true}>
  <div class="ui-concept">
    <section class="concept-intro">
      <div><span class="concept-tag">DESIGN PREVIEW · NOT APPLIED TO THE LIVE UI</span><h1>A quieter, more modern tool workspace.</h1><p>This concept keeps the current workflow, but improves visual grouping, input clarity, and result emphasis without adding decorative complexity.</p></div>
      <aside><b>Direction</b><span>Warm neutral background</span><span>Deep forest accent</span><span>Compact controls</span><span>Soft elevation</span></aside>
    </section>
    <div class="concept-workspace">
      <Calculator client:load {scale} title="Common 4.0 calculator" storageKey="ui-preview"/>
      <CommonScaleReference />
    </div>
    <section class="concept-notes"><div><b>01</b><h2>Clear grouping</h2><p>Previous semesters, current courses, and results are visually distinct without becoming separate screens.</p></div><div><b>02</b><h2>Calmer controls</h2><p>Inputs use a soft neutral fill and stronger focus state instead of heavy borders.</p></div><div><b>03</b><h2>Result first</h2><p>The calculated GPA remains the strongest visual element while secondary totals stay readable.</p></div></section>
  </div>
</BaseLayout>

<style is:global>
.ui-concept{--concept-ink:#18211d;--concept-muted:#68736d;--concept-line:#dce3dd;--concept-surface:#fff;--concept-soft:#f2f5f1;--concept-accent:#176b4b;--concept-warm:#f5f1e8;background:linear-gradient(180deg,#f5f1e8 0,#fafaf7 430px,#fff 430px);margin-top:0;padding:70px max(24px,calc((100vw - 1180px)/2)) 90px;color:var(--concept-ink)}
.ui-concept .concept-intro{display:grid;grid-template-columns:1.5fr .5fr;gap:70px;align-items:end;margin-bottom:42px}.ui-concept .concept-tag{display:inline-flex;padding:7px 10px;border:1px solid #cfd9d1;border-radius:999px;background:#ffffffa8;color:#34624e;font-size:10px;font-weight:800;letter-spacing:.11em}.ui-concept .concept-intro h1{max-width:720px;margin:18px 0 12px;font:500 clamp(38px,5vw,60px)/1.04 ui-serif,Georgia,serif;letter-spacing:-.045em}.ui-concept .concept-intro p{max-width:680px;margin:0;color:#626d66;font-size:16px;line-height:1.7}.ui-concept .concept-intro aside{display:flex;flex-direction:column;gap:7px;padding:20px;border-left:1px solid #cfd7cf;color:#657068;font-size:12px}.ui-concept .concept-intro aside b{color:#25332b;font-size:13px;margin-bottom:3px}.ui-concept .concept-workspace{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(330px,.7fr);gap:22px;align-items:start}
.ui-concept .calc-card,.ui-concept .common-scale{margin:0;max-width:none;border:1px solid rgba(33,55,43,.12);border-radius:16px;background:rgba(255,255,255,.96);box-shadow:0 18px 55px rgba(36,53,42,.08)}.ui-concept .calc-card{padding:28px}.ui-concept .calc-head{border-color:#e9ede9}.ui-concept .calc-head h2{font-size:24px;letter-spacing:-.025em}.ui-concept .eyebrow{color:var(--concept-accent);font-size:10px}.ui-concept .mode{height:42px;border:1px solid #e1e7e2;border-radius:999px;background:#f1f4f1}.ui-concept .mode button{border-radius:999px;padding:7px 16px}.ui-concept .mode .active{color:#fff;background:var(--concept-accent);box-shadow:none}.ui-concept .course input,.ui-concept .course select,.ui-concept .semester-row input{border-color:transparent;border-radius:9px;background:#f2f5f2;outline:none}.ui-concept .course input:focus,.ui-concept .course select:focus,.ui-concept .semester-row input:focus{border-color:#3d8568;background:#fff;box-shadow:0 0 0 3px rgba(23,107,75,.11)}.ui-concept .semester-history{border:0;border-radius:11px;background:#f1f4f0}.ui-concept .semester-title button{border-color:#d2ddd5;color:#176b4b}.ui-concept .add{color:#176b4b}.ui-concept .result{border:1px solid rgba(255,255,255,.08);border-radius:12px;background:linear-gradient(125deg,#173c2e,#245c47);box-shadow:0 12px 28px rgba(22,62,46,.17)}.ui-concept .result strong{font-variant-numeric:tabular-nums}.ui-concept .save-state span{color:#48705e}
.ui-concept .common-scale{padding:25px}.ui-concept .common-scale .section-heading{display:block;margin-bottom:12px}.ui-concept .common-scale h2{font-size:25px;margin:5px 0}.ui-concept .scale-intro{display:block;margin-bottom:18px}.ui-concept .scale-intro>p{font-size:13px;line-height:1.65}.ui-concept .scale-intro aside{margin-top:13px;border:0;border-radius:9px;background:#f8f2e3}.ui-concept .common-scale th,.ui-concept .common-scale td{padding:10px 12px;font-size:12px}.ui-concept .common-scale th:last-child,.ui-concept .common-scale td:last-child{display:none}.ui-concept .table-wrap{border-radius:9px}.ui-concept .concept-notes{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:24px}.ui-concept .concept-notes>div{padding:22px;border:1px solid #e4e8e3;border-radius:12px;background:#fff}.ui-concept .concept-notes b{color:#1c7654;font-size:11px}.ui-concept .concept-notes h2{margin:8px 0 5px;font-size:15px}.ui-concept .concept-notes p{margin:0;color:#6b746e;font-size:12px;line-height:1.55}
@media(max-width:960px){.ui-concept .concept-workspace{grid-template-columns:1fr}.ui-concept .concept-intro{grid-template-columns:1fr;gap:22px}.ui-concept .concept-intro aside{display:none}.ui-concept .common-scale th:last-child,.ui-concept .common-scale td:last-child{display:table-cell}}@media(max-width:720px){.ui-concept{padding:45px 16px 65px}.ui-concept .concept-notes{grid-template-columns:1fr}.ui-concept .calc-card,.ui-concept .common-scale{border-radius:12px}.ui-concept .calc-card{padding:18px}}
</style>
